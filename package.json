{
  "name": "training-journal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run",
    "build:cloud": "FITNESS_CLOUD=1 vite build --base /",
    "dev:cloud": "wrangler dev --config wrangler.local.jsonc --port 8787",
    "deploy:cloud": "npm run check && npm test && npm run build:cloud && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.7.11",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
