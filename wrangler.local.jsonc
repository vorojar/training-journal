{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-saas",
  "main": "server/worker.ts",
  "account_id": "7f60927f51d4800986ed15378823417e",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-saas-db",
      "database_id": "001db15b-e545-4619-ba13-3acb1dece874",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_URL": "http://localhost:8787",
  },
  "observability": {
    "enabled": false,
  },
}
